SERVICE_NAME=factcheck-service
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://redis:6379/0

# Cache
CACHE_TTL_SECONDS=604800

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Evidence mode: REGISTRY_ONLY (default), OFFLINE_ONLY, HYBRID
EVIDENCE_MODE=REGISTRY_ONLY

# Timeouts
REQUEST_TIMEOUT_SECONDS=20
DOI_TIMEOUT_SECONDS=3
URL_TIMEOUT_SECONDS=3
SOURCE_FETCH_TIMEOUT_SECONDS=8

# Limits
MAX_TEXT_CHARS=400000
MAX_REFERENCES_TO_CHECK=300
MAX_URLS_TO_CHECK=200

# Concurrent reference lookups (Crossref/DataCite/doi.org)
REFERENCE_CHECK_CONCURRENCY=8

# Bounds for the in-process cache used when Redis is unreachable
MEMORY_CACHE_MAX_ENTRIES=50000
MEMORY_CACHE_SWEEP_SECONDS=60

# API keys (comma-separated, optional)
API_KEYS=

# Features
ENABLE_DOCS=true
ENABLE_WIKIPEDIA_EVIDENCE=true
ENABLE_OPENAI_WEBSEARCH=false

# LLM Verification (OpenAI) - enables semantic claim analysis
ENABLE_LLM_VERIFICATION=true
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# Semantic Scholar - searches 200M+ academic papers for evidence
ENABLE_SEMANTIC_SCHOLAR=true
SEMANTIC_SCHOLAR_API_KEY=

# Confidence Scoring - adds 0-100 confidence scores with grade (A-F)
ENABLE_CONFIDENCE_SCORING=true

# Claim Decomposition - breaks compound claims into atomic sub-claims
ENABLE_CLAIM_DECOMPOSITION=true
