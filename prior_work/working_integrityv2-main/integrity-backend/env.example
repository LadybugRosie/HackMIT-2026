# =============================================================================
# Editorrah Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# For Railway deployment, set these in the Railway dashboard

# -----------------------------------------------------------------------------
# REQUIRED - MongoDB Connection
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=editorrah_integrity

# -----------------------------------------------------------------------------
# REQUIRED - Security Keys
# -----------------------------------------------------------------------------
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
INTEGRITY_SIGNING_KEY=your-64-character-hex-signing-key-here

# -----------------------------------------------------------------------------
# REQUIRED - Invitation Code
# -----------------------------------------------------------------------------
# 12-digit code required for signup. MUST be set in production!
# Generate: python -c "import random; print(''.join([str(random.randint(0, 9)) for _ in range(12)]))"
INVITATION_CODE=your-12-digit-code-here

# -----------------------------------------------------------------------------
# OPTIONAL - Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# OPTIONAL - CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# OPTIONAL - Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - AWS Rekognition Configuration (for Face Verification)
# -----------------------------------------------------------------------------
# If not configured, face verification will be bypassed (system still works)
# Get credentials from AWS IAM console
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=us-east-1
# Collection ID for storing face embeddings (auto-created if doesn't exist)
AWS_REKOGNITION_COLLECTION_ID=integrity-faces